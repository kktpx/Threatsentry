# ThreatSentry Backend Environment Configuration
APP_ENV=development
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
ALLOWED_ORIGINS=http://localhost:3000
MODEL_PATH=ml/models/web_ids_model_v1.0.0.joblib

# Local Testing Boundary (Permits loopback target http://localhost:8080 during development only)
# STRICTLY FORBIDDEN (raises ValueError) when APP_ENV=production
SCAN_ALLOW_LOCAL=true
SCAN_MAX_DURATION_SECONDS=600
RATE_LIMIT_IP_PER_MINUTE=120
RATE_LIMIT_SCANS_PER_HOUR=10
